# Cursor Dashboard → Integrations → API key
CURSOR_API_KEY=

# Optional: model id (default: pick composer-2-fast if listed, else composer-2, else auto)
# CURSOR_MODEL_ID=composer-2-fast

# Optional: voice transcription support for Telegram voice messages
# OPENAI_API_KEY=
# VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Defaults used when the user asks for calendar creation but omits them
# DEFAULT_TIMEZONE=Europe/Helsinki
# DEFAULT_CALENDAR_ID=primary

# BotFather token for @Manager4Yehor_bot (never commit real value)
MANAGER4YEHOR_BOT_TOKEN=

# Comma-separated Telegram user ids allowed to use the bot (empty = allow all)
# ALLOWED_TELEGRAM_USER_IDS=123456789

# Proactive email monitor. If TELEGRAM_NOTIFY_CHAT_IDS is empty, the bot remembers chats that message it.
# EMAIL_MONITOR_ENABLED=true
# EMAIL_MONITOR_INTERVAL_MINUTES=60
# EMAIL_MONITOR_LOOKBACK_HOURS=2
# TELEGRAM_NOTIFY_CHAT_IDS=123456789
# EMAIL_MONITOR_STATE_PATH=/app/data/email-monitor-state.json

# After each bot reply (and /remember), run a small Cursor agent pass to append soul.md / memory.md (default on)
# MEMORY_AGENT_UPDATES=false

# Telegram user MCP (same as ~/.cursor/mcp.json telegramMainFi)
TG_APP_ID=
TG_API_HASH=

# Optional overrides for paths on non-standard hosts
# GMAIL_MCP_PYTHON=/root/.cursor/gmail-venv/bin/python
# GMAIL_MCP_SERVER_SCRIPT=/root/.cursor/scripts/gmail_mcp_stdio_server.py
# TELEGRAM_NODE=/usr/bin/node
# TELEGRAM_MCP_SCRIPT=/root/.cursor/telegram-mcp-cursor.js
# TG_SESSION_PATH=/root/.telegram-mcp/session.json
