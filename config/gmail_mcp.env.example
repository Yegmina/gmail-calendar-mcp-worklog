# Copy to ~/.cursor/secrets/gmail_mcp.env — chmod 600 — do not commit.
# Cursor substitutes ${env:GMAIL_MCP_CLIENT_ID} in ~/.cursor/mcp.json for the *hosted* Gmail MCP.
#
# GCP (example project display name: "Gmail MCP Personal"):
#   Web client → Authorized redirect URI:
#     cursor://anysphere.cursor-mcp/oauth/callback
# Hosted MCP scopes (separate from Desktop / gmail-local):
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.compose
#
# Desktop token (gmail_list_recent.py --auth) uses:
#   https://www.googleapis.com/auth/gmail.modify
#   https://www.googleapis.com/auth/calendar
#   https://www.googleapis.com/auth/tasks
# Register those under Google Auth Platform → Data access, enable the matching APIs in the same project, then re-auth after changes.
#
# Generate this file from downloaded Web client JSON:
#   bash scripts/import_gmail_mcp_oauth_from_console_json.sh /path/to/client_secret_*.json
#
export GMAIL_MCP_CLIENT_ID=""
export GMAIL_MCP_CLIENT_SECRET=""
